{
 "schema": 1,
 "about": "One ledger for the xMustard-owned process tree (PARITY_REQUIREMENTS §7, §12.4-12.5). Gate v2 (rss_bench_v2.py) attributes every sampled process to a component through process_roles, compares measurements with the design lines in components, reconciles those lines with the per-workstream lines, and fails a workstream whose measured delta against its base exceeds its line plus tolerance. MiB = 2^20 bytes.",
 "gate": {
  "limit_bytes": 100000000,
  "metric": "ps-RSS summed over the xMustard-owned tree in one snapshot every 100 ms; externals excluded and reported on their own lines",
  "source": "PARITY_REQUIREMENTS §3, §7.6"
 },
 "process_roles": {
  "about": "Registered roots carry their own component. Descendants are matched by executable name (first matching rule wins; argv1 narrows a rule to a subcommand). Unknown descendants of owned processes count as owned (unclassified:<exe>). External rules and everything below them are never counted in the gate. owned_binaries are pulled in from agent trees: an xMustard binary an agent launched (hook client, shim, relay) counts toward the gate (§12.4 item on hook-client accounting).",
  "owned_binaries": ["xmustard-api", "xmustard-mcp", "xmustard-core", "xmustard-ops", "xmustard-hook", "xmustard-relay", "xmustard-eval"],
  "rules": [
   {"exe": ["xmustard-api"], "component": "go_daemon", "class": "owned"},
   {"exe": ["xmustard-mcp"], "component": "mcp_access", "class": "owned", "note": "stdio Go shim; transitional until WS-13 serves MCP over HTTP"},
   {"exe": ["xmustard-relay"], "component": "mcp_access", "class": "owned"},
   {"exe": ["xmustard-hook"], "component": "hook_client", "class": "owned"},
   {"exe": ["xmustard-ops", "xmustard-eval"], "component": "ops_cli", "class": "owned"},
   {"exe": ["xmustard-core"], "argv1": ["serve"], "component": "rust_index_service", "class": "owned"},
   {"exe": ["xmustard-core"], "component": "rust_core_per_call", "class": "owned", "note": "per-call core children today; the heavy-slot worker after WS-02/WS-14"},
   {"exe": ["git"], "component": "git_child", "class": "owned"},
   {"exe": ["ast-grep", "sg", "pgrep"], "component": "helper_child", "class": "owned"},
   {"exe": ["gopls", "rust-analyzer", "typescript-language-server", "tsserver", "pyright-langserver", "pylsp", "clangd", "jdtls", "vscode-json-language-server"], "component": "lsp_server", "class": "external"},
   {"exe": ["scip-typescript", "scip-go", "scip-python", "scip-java", "scip-clang"], "component": "scip_indexer", "class": "external"},
   {"exe": ["xmustard-embedder", "llama-server", "ollama", "onnxruntime"], "component": "helper_model", "class": "external"},
   {"exe": ["go", "cargo", "rustc", "node", "npm", "npx", "pnpm", "yarn", "bun", "deno", "python", "python3", "pytest", "make", "sh", "bash", "zsh", "dash", "fish", "java", "mvn", "gradle", "tsc", "vitest", "jest", "claude", "codex", "opencode", "pi"], "component": "runner_command", "class": "external", "note": "compilers, tests, terminals and agent CLIs run by why_failed, diagnostics, verification profiles or runs (§7.6)"}
  ]
 },
 "components": {
  "go_daemon": {"steady_mib": 22, "peak_mib": 28, "process": "go_daemon", "basis": "§7.2 Go daemon line (GOMEMLIMIT = this line, §12.5)"},
  "sqlite_governance": {"steady_mib": 5, "peak_mib": 5, "process": "go_daemon", "peak_in_heavy_slot": true, "basis": "§7.2: 3-5 steady in-process; the 12 MiB bulk-import peak runs inside the heavy slot"},
  "rust_index_base": {"steady_mib": 3, "peak_mib": 3, "process": "rust_index_service", "basis": "§7.2, measured Rust baseline 1.9-2.7"},
  "symbol_graph": {"steady_mib": 12, "peak_mib": 15, "process": "rust_index_service", "basis": "§7.2 CSR + names; critic: realistic density 180-380 B/symbol"},
  "code_bm25": {"steady_mib": 5, "peak_mib": 8, "process": "rust_index_service", "basis": "§7.2"},
  "static_embeddings": {"steady_mib": 6, "peak_mib": 10, "process": "rust_index_service", "basis": "§7.2, off unless the retrieval gate passes"},
  "vectors": {"steady_mib": 3, "peak_mib": 4, "process": "rust_index_service", "basis": "§7.2"},
  "watcher": {"steady_mib": 3, "peak_mib": 4, "process": "rust_index_service", "basis": "§7.2 watcher and stat cache"},
  "mcp_access": {"steady_mib": 0, "peak_mib": 0, "process": "mcp_access", "basis": "§7.2: 0 over HTTP; <=3 MiB per stdio relay (each measured stdio Go shim is 8-12 MiB today)"},
  "heavy_slot": {"steady_mib": 0, "peak_mib": 25, "process": "rust_core_per_call", "basis": "§7.2 exclusive heavy slot (parse worker, bulk import, index writer, helper)"},
  "git_child": {"steady_mib": 0, "peak_mib": 5, "process": "git_child", "basis": "§7.2 rare git child"},
  "margin": {"steady_mib": 5, "peak_mib": 2, "process": null, "basis": "§7.2 margin"}
 },
