{
  "compilerOptions": {
    "target": "ES2023",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2023", "DOM"],
    "types": ["node"],
    "strict": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true,
    "baseUrl": ".",
    "paths": {
      "typebox": ["node_modules/@earendil-works/pi-coding-agent/node_modules/typebox/build/index.d.mts"],
      "@earendil-works/pi-ai": ["node_modules/@earendil-works/pi-coding-agent/node_modules/@earendil-works/pi-ai/dist/compat.d.ts"]
    }
  },
  "include": ["src/**/*.ts", "test/**/*.ts"]
}
