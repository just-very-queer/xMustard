# The hardened Git diff policy (WS-64 in WS-35). rust-core/src/gitdiff.rs renders every
# line; api-go/internal/gitdiff renders the lines it implements (scrub, env, config and
# the review mode). Tab-separated: kind, value. Paths are the Unix null device.
scrub	GIT_
scrub	XMUSTARD_
env	GIT_CONFIG_NOSYSTEM=1
env	GIT_CONFIG_GLOBAL=/dev/null
env	GIT_ATTR_NOSYSTEM=1
env	GIT_TERMINAL_PROMPT=0
env	GIT_OPTIONAL_LOCKS=0
env	LC_ALL=C
config	core.hooksPath=/dev/null
config	core.fsmonitor=false
config	core.attributesFile=/dev/null
config	core.bigFileThreshold=512m
config	diff.suppressBlankEmpty=false
review.config	core.quotePath=true
review	--no-color
review	--no-ext-diff
review	--no-textconv
review	--binary
review	--full-index
review	--no-renames
review	--no-relative
review	--diff-algorithm=myers
review	--indent-heuristic
review	--inter-hunk-context=0
review	-U3
review	--src-prefix=a/
review	--dst-prefix=b/
review	--ignore-submodules=none
review	--submodule=short
review	-O/dev/null
symbols.config	core.quotePath=false
symbols	--no-color
symbols	--no-ext-diff
symbols	--no-textconv
symbols	--no-renames
symbols	--no-relative
symbols	--diff-algorithm=myers
symbols	--indent-heuristic
symbols	--inter-hunk-context=0
symbols	-U0
symbols	--ignore-cr-at-eol
symbols	--src-prefix=a/
symbols	--dst-prefix=b/
symbols	--ignore-submodules=none
symbols	--submodule=short
symbols	-O/dev/null
