+func TestReadAllAdmittedPresizeKeepsAdmission(t *testing.T) {
+	data := bytes.Repeat([]byte("y"), 100_000)
+	// the pool cannot admit the file: refused as before, nothing left reserved
+	pool := NewByteBudget(1000)
+	scope := NewScope(pool)
+	if _, err := ReadAllAdmitted(scope, statReader{bytes.NewReader(data), int64(len(data))}, 1<<20); !errors.Is(err, ErrOverloaded) {
+		t.Fatalf("small pool: %v", err)
+	}
+	scope.Close()
+	if pool.InUse() != 0 {
+		t.Fatalf("pool leaked %d", pool.InUse())
+	}
+	// a Limited scope's cap still applies to the up-front reservation
+	parent := NewScope(NewByteBudget(1 << 20))
+	defer parent.Close()
+	if _, err := ReadAllAdmitted(parent.Limited(50_000), statReader{bytes.NewReader(data), int64(len(data))}, 1<<20); !errors.Is(err, ErrAdmissionLimit) {
+		t.Fatalf("limited scope: %v", err)
+	}
