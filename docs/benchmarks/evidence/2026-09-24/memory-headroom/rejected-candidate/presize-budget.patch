+// presize reserves and allocates n bytes of capacity up front. It is only a hint: a
+// size past max, or one the pool cannot admit now, leaves Write's chunked admission
+// to decide exactly as it would without it.
+func (c *CaptureWriter) presize(n int64) {
+	if n <= 0 || n > int64(c.max) || c.buf != nil {
+		return
+	}
+	if c.scope.Acquire(n) != nil {
+		return
+	}
+	c.reserved += n
+	c.buf = make([]byte, 0, n)
+}
+
+func regularFileSize(r io.Reader) int64 {
+	f, ok := r.(interface{ Stat() (os.FileInfo, error) })
+	if !ok {
+		return 0
+	}
+	info, err := f.Stat()
+	if err != nil || !info.Mode().IsRegular() {
+		return 0
+	}
+	return info.Size()
 }
 
