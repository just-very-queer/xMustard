+// statReader reports a fixed stat size that need not match its content, as a file
+// that grows or shrinks between stat and read would.
+type statReader struct {
+	*bytes.Reader
+	size int64
+}
+
+func (s statReader) Stat() (os.FileInfo, error) { return fakeInfo{size: s.size}, nil }
+
+type fakeInfo struct {
+	os.FileInfo
+	size int64
+}
+
+func (f fakeInfo) Size() int64       { return f.size }
+func (f fakeInfo) Mode() os.FileMode { return 0o644 }
+
+func TestReadAllAdmittedPresizesRegularFiles(t *testing.T) {
+	data := bytes.Repeat([]byte("0123456789abcdef"), 40_000) // 640,000 bytes: many 32 KiB writes
+	path := filepath.Join(t.TempDir(), "f")
+	if err := os.WriteFile(path, data, 0o644); err != nil {
+		t.Fatal(err)
+	}
+	f, err := os.Open(path)
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer f.Close()
+	pool := NewByteBudget(1 << 20)
+	scope := NewScope(pool)
+	got, err := ReadAllAdmitted(scope, f, 1<<20)
+	if err != nil || !bytes.Equal(got, data) {
+		t.Fatalf("read: err=%v len=%d", err, len(got))
+	}
+	if cap(got) != len(data) || scope.Held() != int64(len(data)) {
+		t.Fatalf("want one exact allocation and reservation: cap=%d held=%d size=%d", cap(got), scope.Held(), len(data))
+	}
+	scope.Close()
+	if pool.InUse() != 0 {
+		t.Fatalf("pool not released: %d", pool.InUse())
+	}
+}
+
+func TestReadAllAdmittedStatSizeIsOnlyAHint(t *testing.T) {
+	data := bytes.Repeat([]byte("x"), 100_000)
+	for _, size := range []int64{10, 50_000, 200_000} { // grew, grew, shrank since stat
+		got, err := ReadAllAdmitted(NewScope(NewByteBudget(1<<20)), statReader{bytes.NewReader(data), size}, 1<<20)
+		if err != nil || !bytes.Equal(got, data) {
+			t.Fatalf("stat %d: err=%v len=%d", size, err, len(got))
+		}
+	}
+	// a hint past max is ignored; the read still fails as too large
+	if _, err := ReadAllAdmitted(NewScope(NewByteBudget(1<<20)), statReader{bytes.NewReader(data), 100_000}, 1000); !errors.Is(err, ErrTooLarge) {
+		t.Fatalf("over max: %v", err)
+	}
+}
