{
  "protocolVersion": "2025-06-18",
  "tools": [
    {
      "_meta": {
        "anthropic/maxResultSizeChars": 132096
      },
      "annotations": {
        "openWorldHint": false,
        "readOnlyHint": true,
        "title": "Ground the session"
      },
      "description": "Orient before acting: what changed, is stale, broken or blocked since the baseline, with index drift and contract breaks (changed signatures).",
      "inputSchema": {
        "additionalProperties": false,
        "properties": {
          "workspace_id": {
            "description": "workspace id; auto-resolved if omitted",
            "type": "string"
          }
        },
        "type": "object"
      },
      "name": "ground",
      "outputSchema": {
        "properties": {
          "_xmustard": {
            "type": "object"
          },
          "generated_at": {
            "type": "string"
          },
          "summary": {
            "type": "string"
          },
          "workspace_id": {
            "type": "string"
          }
        },
        "type": "object"
      }
    },
    {
      "_meta": {
        "anthropic/maxResultSizeChars": 132096
      },
      "annotations": {
        "openWorldHint": false,
        "readOnlyHint": true,
        "title": "Recall shared memory"
      },
      "description": "Shared memory RANKED by query/paths (BM25+path+trust+recency+feedback); non-matches dropped (terms \u003e=3 chars). No args: top-N by working-tree overlap, then recency. verification_mode: peer_verified|single_agent|self_asserted_open_mode (no auth/quorum). conflicts: claim/contradiction/path overlap.",
      "inputSchema": {
        "additionalProperties": false,
        "properties": {
          "limit": {
            "description": "max memories (default 8)",
            "maximum": 50,
            "minimum": 1,
            "type": "integer"
          },
          "paths": {
            "description": "comma-separated repo-relative files to focus on",
            "type": "string"
          },
          "q": {
            "description": "task query to rank memories by",
            "type": "string"
          },
          "workspace_id": {
            "description": "workspace id; auto-resolved if omitted",
            "type": "string"
          }
        },
        "type": "object"
      },
      "name": "recall",
      "outputSchema": {
        "properties": {
          "_xmustard": {
            "type": "object"
          },
          "drift_checked": {
            "type": "integer"
          },
          "generated_at": {
            "type": "string"
          },
          "limit": {
            "type": "integer"
          },
          "query": {
            "type": "string"
          },
          "ranked": {
            "type": "boolean"
          },
          "returned": {
            "type": "integer"
          },
          "stale_count": {
            "type": "integer"
          },
          "workspace_id": {
            "type": "string"
          }
        },
        "type": "object"
      }
    },
    {
      "annotations": {
        "destructiveHint": false,
        "idempotentHint": false,
        "openWorldHint": false,
        "readOnlyHint": false,
        "title": "Propose a memory"
      },
      "description": "Propose a durable memory (fact/decision/gotcha); pending until enough distinct agents verify it (open mode: promoted at once as self_asserted_open_mode). Pass content; optional title, paths (comma-separated files it is about, so recall flags it stale when they change).",
      "inputSchema": {
        "additionalProperties": false,
        "properties": {
          "content": {
            "description": "the memory text to propose",
            "type": "string"
          },
          "paths": {
            "description": "comma-separated repo-relative files the memory is about",
            "type": "string"
          },
          "title": {
            "description": "short title",
            "type": "string"
          },
          "workspace_id": {
            "description": "workspace id; auto-resolved if omitted",
            "type": "string"
          }
        },
        "type": "object"
      },
      "name": "remember",
      "outputSchema": {
        "properties": {
          "_xmustard": {
            "type": "object"
          },
          "id": {
            "type": "string"
          },
          "promoted": {
            "type": "boolean"
          },
          "required_verifications": {
            "type": "integer"
          },
          "status": {
            "type": "string"
          },
          "verification_mode": {
            "type": "string"
          },
          "workspace_id": {
            "type": "string"
          }
        },
        "type": "object"
      }
    },
    {
      "annotations": {
        "destructiveHint": true,
        "idempotentHint": true,
        "openWorldHint": false,
        "readOnlyHint": false,
        "title": "Verify a memory"
      },
      "description": "Verify (approve/reject) a peer's proposed memory; it promotes once enough DISTINCT agents approve. Your identity is your auth token; approve defaults true.",
      "inputSchema": {
        "additionalProperties": false,
        "properties": {
          "approve": {
            "description": "approve (default true) or reject",
            "type": "boolean"
          },
          "entry_id": {
            "description": "the id of the memory entry",
            "type": "string"
          },
          "note": {
            "description": "reason for the verdict, stored with the vote",
            "maxLength": 1000,
            "type": "string"
          },
          "workspace_id": {
            "description": "workspace id; auto-resolved if omitted",
            "type": "string"
          }
        },
        "required": [
          "entry_id"
        ],
        "type": "object"
      },
      "name": "verify",
      "outputSchema": {
        "properties": {
          "_xmustard": {
            "type": "object"
          },
          "id": {
            "type": "string"
          },
          "promoted": {
            "type": "boolean"
          },
          "required_verifications": {
            "type": "integer"
          },
          "status": {
            "type": "string"
          },
          "verification_mode": {
            "type": "string"
          },
          "workspace_id": {
            "type": "string"
          }
        },
        "type": "object"
      }
    },
    {
      "_meta": {
        "anthropic/maxResultSizeChars": 132096
      },
      "annotations": {
        "openWorldHint": false,
        "readOnlyHint": true,
        "title": "Search code"
      },
      "description": "Code search: path:line, snippets, reasons. RRF (K=60) of BM25 over function bodies, comments, names, paths and doc sections; identifier match; trigram typo tolerance (not meaning); reference degree; proximity to seed=\u003csymbol\u003e; pattern: ast-grep (`$A \u0026\u0026 $A()`); symbol: name path; text: body.",
      "inputSchema": {
        "additionalProperties": false,
        "properties": {
          "lang": {
            "description": "pattern: ast-grep hint; else filter, not symbol",
            "maxLength": 256,
            "type": "string"
          },
          "limit": {
            "description": "max hits (default 10)",
            "maximum": 50,
            "minimum": 1,
            "type": "integer"
          },
          "mode": {
            "description": "hybrid (default), text (body)",
            "enum": [
              "hybrid",
              "text",
              "pattern",
              "symbol"
            ],
            "type": "string"
          },
          "q": {
            "description": "the query",
            "type": "string"
          },
          "seed": {
            "description": "proximity seed symbol",
            "type": "string"
          },
          "workspace_id": {
            "description": "workspace id; auto-resolved if omitted",
            "type": "string"
          }
        },
        "required": [
          "q"
        ],
        "type": "object"
      },
      "name": "search",
      "outputSchema": {
        "properties": {
          "_xmustard": {
            "type": "object"
          },
          "generated_at": {
            "type": "string"
          },
          "hits": {
            "type": "array"
          },
          "match_count": {
            "type": "integer"
          },
          "next_cursor": {
            "type": "string"
          },
          "omitted": {
            "type": "integer"
          },
          "query": {
            "type": "string"
          },
          "total": {
            "type": "integer"
          },
          "truncated": {
            "type": "boolean"
          },
          "workspace_id": {
            "type": "string"
          }
        },
        "type": "object"
      }
    },
    {
      "_meta": {
        "anthropic/maxResultSizeChars": 132096
      },
      "annotations": {
        "openWorldHint": false,
        "readOnlyHint": true,
        "title": "Explain a path"
      },
      "description": "Explain a file or directory: purpose, role, key symbols, and how to run/verify it.",
      "inputSchema": {
        "additionalProperties": false,
        "properties": {
          "path": {
            "description": "a repo-relative file or directory path",
            "maxLength": 4096,
            "type": "string"
          },
          "workspace_id": {
            "description": "workspace id; auto-resolved if omitted",
            "type": "string"
          }
        },
        "type": "object"
      },
      "name": "explain",
      "outputSchema": {
        "properties": {
          "_xmustard": {
            "type": "object"
          },
          "cluster": {
            "type": "object"
          },
          "coverage": {
            "type": "object"
          },
          "explanation": {
            "type": "object"
          },
          "freshness": {
            "type": "object"
          },
          "role": {
            "type": "string"
          },
          "summary": {
            "type": "string"
          }
        },
        "type": "object"
      }
    },
    {
      "_meta": {
        "anthropic/maxResultSizeChars": 132096
      },
      "annotations": {
        "openWorldHint": false,
        "readOnlyHint": true,
        "title": "Estimate change impact"
      },
      "description": "Blast radius. symbol= → dependents by depth (d1 breaks), risk, completeness. Go/TS edges are resolved; other languages match names: leads, not proof. path= → a file's lexical referrers. from=\u0026to= → shortest path, per-hop edges. No args → changes since baseline.",
      "inputSchema": {
        "additionalProperties": false,
        "properties": {
          "from": {
            "description": "trace from here",
            "type": "string"
          },
          "max_depth": {
            "description": "hops (default 3; path= 4)",
            "maximum": 32,
            "minimum": 1,
            "type": "integer"
          },
          "path": {
            "description": "a repo-relative file",
            "maxLength": 4096,
            "type": "string"
          },
          "symbol": {
            "description": "name, Container.name, UID or path",
            "type": "string"
          },
          "to": {
            "description": "trace to here",
            "type": "string"
          },
          "workspace_id": {
            "description": "workspace id; auto-resolved if omitted",
            "type": "string"
          }
        },
        "type": "object"
      },
      "name": "impact",
      "outputSchema": {
        "properties": {
          "_xmustard": {
            "type": "object"
          },
          "by_depth": {
            "type": "array"
          },
          "coverage": {
            "type": "object"
          },
          "found": {
            "type": "boolean"
          },
          "freshness": {
            "type": "object"
          },
          "has_more": {
            "type": "boolean"
          },
          "impacted_count": {
            "type": "integer"
          },
          "length": {
            "type": "integer"
          },
          "next_cursor": {
            "type": "string"
          },
          "risk": {
            "type": "string"
          },
          "since": {
            "type": "string"
          },
          "symbol": {
            "type": "string"
          }
        },
        "type": "object"
      }
    },
