            "enum": [
              "upstream",
              "downstream"
            ],
            "type": "string"
          },
          "from": {
            "description": "trace from here",
            "type": "string"
          },
          "head": {
            "description": "scope=compare|commit|range: head",
            "maxLength": 256,
            "type": "string"
          },
          "include_tests": {
            "description": "walk test files (default false)",
            "type": "boolean"
          },
          "limit": {
            "description": "items per depth tier (default 50), or per page with op=",
            "maximum": 500,
            "minimum": 1,
            "type": "integer"
          },
          "max_chars": {
            "description": "result budget (default 8000)",
            "maximum": 65536,
            "minimum": 2000,
            "type": "integer"
          },
          "max_depth": {
