        "additionalProperties": false,
        "properties": {
          "base": {
            "description": "scope=compare|range: base",
            "maxLength": 256,
            "type": "string"
          },
          "cursor": {
            "description": "next_cursor of the previous page",
            "maxLength": 64,
            "type": "string"
          },
          "direction": {
